{
  "name": "verno",
  "version": "1.0.0",
  "description": "AI Software Development Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "ai",
    "development"
  ],
  "author": "Parham Jenani",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "monaco-editor": "^0.57.0"
  },
  "build": {
    "appId": "com.example.verno-desktop",
    "productName": "Verno",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/logo.ico"
    },
    "mac": {
      "icon": "assets/logo.png"
    },
    "linux": {
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    }
  }
}
